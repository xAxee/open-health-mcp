POSTGRES_PASSWORD=change-me
MCP_AUTH_TOKEN=replace-with-a-long-random-token-at-least-32-characters
# Public HTTPS origin without a trailing slash. OAuth resource is this value plus /mcp.
OAUTH_BASE_URL=https://health.example.com
OAUTH_OWNER_PASSWORD=replace-with-a-different-long-random-password

GARMIN_EMAIL=
GARMIN_PASSWORD=
# Optional one-time code when Garmin requests MFA during authentication.
GARMIN_MFA_CODE=
# Maximum activities enriched with laps, HR zones, and bounded streams per 31-day sync chunk (0 disables enrichment).
GARMIN_ACTIVITY_ENRICHMENT_LIMIT=10
# Delay between optional Garmin activity enrichment requests.
GARMIN_ACTIVITY_ENRICHMENT_DELAY_MS=250

SYNC_INTERVAL_HOURS=3
SYNC_LOOKBACK_DAYS=3