# Updated automatically by deploy/deploy.sh. Use an immutable SHA tag in production.
OPENHEALTHMCP_IMAGE=ghcr.io/xaxee/open-health-mcp:sha-0000000000000000000000000000000000000000

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password

# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-token-at-least-32-characters

OAUTH_BASE_URL=https://health.hubertiwan.pl
# Generate independently with: openssl rand -hex 32
OAUTH_OWNER_PASSWORD=replace-with-a-different-long-random-password

GARMIN_EMAIL=
GARMIN_PASSWORD=
# Optional one-time code. Clear it after successful authentication.
GARMIN_MFA_CODE=

SYNC_INTERVAL_HOURS=3
SYNC_LOOKBACK_DAYS=3